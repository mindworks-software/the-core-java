FROM adoptopenjdk/openjdk8:alpine
VOLUME /tmp

# Install dependencies
RUN apk --no-cache add curl bash

ARG APP_NAME=app
ARG APP_ZIP=target/app.zip

RUN mkdir -pv /app/log /app/config /app/run

COPY ${APP_ZIP} /tmp

RUN unzip -d /app /tmp/*.zip

WORKDIR /app

ENTRYPOINT ["/bin/sh"]

ENV app_name $APP_NAME

CMD ["echo", "/app/$app_name/bin/router"]
